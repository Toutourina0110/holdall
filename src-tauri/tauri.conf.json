{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Holdall",
  "version": "0.0.1",
  "identifier": "io.github.toutourina0110.holdall",
  "build": {
    "frontendDist": "placeholder",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "windows": [
      {
        "title": "Holdall",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
