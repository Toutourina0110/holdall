{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Holdall",
  "version": "0.2.0",
  "identifier": "io.github.toutourina0110.holdall",
  "build": {
    "frontendDist": "placeholder",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && node scripts/fetch-node.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../.next/standalone/": "app/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMEVDNDVCMTM0ODQ3ODkKUldTSlIwZ1RXOFFPMmlodzVza1N6bmtQVTBrb3JDQTBUTEp0ejU4SzBvS2E2OUs1d3FqY0lKK0EK",
      "endpoints": [
        "https://github.com/Toutourina0110/holdall/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
