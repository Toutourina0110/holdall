# Copy this file to .env and adjust the values.
# Never commit the .env file.

# Public URL of the instance, used for links and cookies (required from phase 1).
APP_URL=http://localhost:3000

# Random string of at least 32 characters, used for sessions and encryption (required from phase 1).
# Generate one in PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# On a Linux server: openssl rand -base64 48
APP_SECRET=change-me-to-a-random-string-of-32-characters-or-more

# Where Holdall stores its database and user files. A relative path resolves from the folder
# where you run pnpm (the project root), so pnpm dev, pnpm start and pnpm db:migrate share it.
# Defaults to ./data in development and /data in Docker.
DATA_DIR=./data

# Port the server listens on. Defaults to 3000.
PORT=3000

# Build target: "server" (Docker, browser access) or "desktop" (Tauri app). Defaults to server.
HOLDALL_TARGET=server

# Allow anyone to create an account. Defaults to false (admin invitations only).
ALLOW_REGISTRATION=false

# Set to true behind Cloudflare or a reverse proxy, so the real client IP is used for rate limiting.
TRUST_PROXY=false

# With TRUST_PROXY=true, the header that holds the visitor's address. Use the one your proxy always sets itself:
# cf-connecting-ip (Cloudflare, Render), x-real-ip (Nginx), x-forwarded-for (last entry, Coolify, Caddy, Traefik).
# auto tries them in that order and is only safe if your proxy overwrites all three. Defaults to auto.
TRUST_PROXY_HEADER=auto

# Public demo mode: each visitor gets an isolated account with made-up data. Never turn it on for real data. Defaults to false.
DEMO_MODE=false

# Minutes after which a demo account and its files are deleted. At least 5. Defaults to 60.
DEMO_RESET_MINUTES=60

# Google Calendar sync (optional). Create your own OAuth app, see https://holdall.site/docs/install/calendar-sync/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook calendar sync through Microsoft Graph (optional).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Allow plugins that ask for dangerous permissions (full access, any file, starting programs, raw network).
# Such a plugin can read every account's data on a server. Defaults to false on a server and true on the desktop app.
ALLOW_UNSAFE_PLUGINS=

# Plugin registry index. Leave empty to use the official GitHub registry.
PLUGIN_REGISTRY_URL=

# Number of background jobs (downloads, conversions, sync) that run at the same time. Defaults to 2.
MAX_CONCURRENT_JOBS=2

# Maximum upload size in megabytes. Defaults to 500.
MAX_UPLOAD_MB=500

# Update yt-dlp automatically on the desktop app. Defaults to true.
YTDLP_AUTO_UPDATE=true

# Paths to yt-dlp and ffmpeg. The Docker image sets them. Leave empty to use the copies Holdall installs on desktop or the ones on your PATH.
YTDLP_PATH=
FFMPEG_PATH=
